  "rewrites": [
    {
      "source": "/planos",
      "destination": "/planos.html"
    },
    {
      "source": "/consultoria",
      "destination": "/consultoria.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    },
    {
      "source": "/privacidade",
